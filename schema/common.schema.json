{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://config.songbird-fw.com/v1alpha1/common.schema.json",
  "title": "Songbird common definitions",
  "description": "Shared building blocks for every Songbird configuration object. Not a document schema by itself.",
  "$defs": {
    "apiVersion": {
      "const": "config.songbird-fw.com/v1alpha1"
    },

    "objectName": {
      "description": "Primary key of an object within its kind namespace. Human-readable, stable, used in Git diffs and in references. Address and AddressGroup share one namespace; Service and ServiceGroup share one namespace; Interface and Zone share one namespace.",
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$",
      "not": { "enum": ["any", "all", "none"] }
    },

    "reference": {
      "description": "Reference to another object by name.",
      "$ref": "#/$defs/objectName"
    },

    "referenceOrAny": {
      "description": "Reference to another object by name, or the wildcard 'any'.",
      "anyOf": [
        { "$ref": "#/$defs/objectName" },
        { "const": "any" }
      ]
    },

    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },

    "colorHex": {
      "description": "CSS hex notation. Used only inside kind: Color.",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },

    "colorRef": {
      "description": "Reference to a Color object by name (never a literal hex: colours are a classification, defined once in the palette).",
      "$ref": "#/$defs/objectName"
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/objectName" },
        "uuid": {
          "description": "Generated by the system on first save; never written by hand. Lets the UI track renames.",
          "$ref": "#/$defs/uuid"
        },
        "comment": { "type": "string", "maxLength": 1024 },
        "color": { "$ref": "#/$defs/colorRef" },
        "category": {
          "description": "Free-form grouping label shown in the UI (e.g. 'internet', 'infra').",
          "type": "string",
          "maxLength": 63
        },
        "labels": {
          "description": "Arbitrary key/value labels for future selector support.",
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 63 },
          "propertyNames": { "pattern": "^[a-z0-9]([a-z0-9._/-]*[a-z0-9])?$" }
        }
      }
    },

    "ipv4Address": {
      "type": "string",
      "format": "ipv4",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
    },
    "ipv6Address": {
      "type": "string",
      "format": "ipv6",
      "pattern": "^[0-9a-fA-F:]+(:[0-9]{1,3}(\\.[0-9]{1,3}){3})?$",
      "minLength": 2
    },
    "ipAddress": {
      "anyOf": [ { "$ref": "#/$defs/ipv4Address" }, { "$ref": "#/$defs/ipv6Address" } ]
    },

    "ipv4Cidr": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$"
    },
    "ipv6Cidr": {
      "type": "string",
      "pattern": "^[0-9a-fA-F:]+/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$",
      "minLength": 4
    },
    "cidr": {
      "description": "Subnet in CIDR notation (R-012). Netmask notation is not accepted.",
      "anyOf": [ { "$ref": "#/$defs/ipv4Cidr" }, { "$ref": "#/$defs/ipv6Cidr" } ]
    },

    "macAddress": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$",
      "description": "Colon-separated, lower or upper case. Dash notation is normalised by the importer, not accepted here."
    },

    "fqdn": {
      "type": "string",
      "format": "hostname",
      "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}\\.?$"
    },

    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },

    "portOrRange": {
      "description": "Single port (443) or inclusive range ('10000-20000').",
      "anyOf": [
        { "$ref": "#/$defs/port" },
        { "type": "string", "pattern": "^([1-9][0-9]{0,4})-([1-9][0-9]{0,4})$" }
      ]
    },

    "vlanId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4094
    },

    "linuxDeviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 15,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },

    "duration": {
      "description": "Go-style duration string, e.g. '30s', '12h', '7d'.",
      "type": "string",
      "pattern": "^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$",
      "minLength": 2
    }
  }
}
