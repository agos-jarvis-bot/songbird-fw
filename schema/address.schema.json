{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://config.songbird-fw.com/v1alpha1/address.schema.json",
  "title": "Address",
  "description": "A named network address object (R-012). Exactly one of subnet, range, fqdn, mac must be set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Address" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interface": {
          "description": "Optional hint restricting where this Address is expected to appear (used by the UI and by DHCP static bindings). Not a match criterion in Policies.",
          "$ref": "common.schema.json#/$defs/reference"
        },
        "subnet": { "$ref": "common.schema.json#/$defs/cidr" },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "common.schema.json#/$defs/ipAddress" },
            "end":   { "$ref": "common.schema.json#/$defs/ipAddress" }
          }
        },
        "fqdn": {
          "description": "Resolved periodically by the DNS Subsystem; the resolved set is compiled into the Data Plane.",
          "$ref": "common.schema.json#/$defs/fqdn"
        },
        "mac": {
          "description": "Matches on source MAC only; valid only as Source in Policies whose incoming side is a directly attached Interface.",
          "$ref": "common.schema.json#/$defs/macAddress"
        }
      },
      "oneOf": [
        { "required": ["subnet"] },
        { "required": ["range"] },
        { "required": ["fqdn"] },
        { "required": ["mac"] }
      ]
    }
  }
}
