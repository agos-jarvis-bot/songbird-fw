{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://config.songbird-fw.com/v1alpha1/servicegroup.schema.json",
  "title": "ServiceGroup",
  "description": "A named list of Service and/or ServiceGroup objects (R-011). Cycles are rejected by the validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "ServiceGroup" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members"],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/reference" }
        }
      }
    }
  }
}
