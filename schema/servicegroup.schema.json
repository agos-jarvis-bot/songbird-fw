{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://config.songbird-fw.com/v1alpha1/servicegroup.schema.json",
  "title": "ServiceGroup",
  "description": "A named, flat list of Service objects (RA R-011). A ServiceGroup cannot contain another ServiceGroup (team decision 2026-10-19: groups are flat); the validator rejects a member that is not a Service. Members may mix address families / protocols.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "ServiceGroup"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members"
      ],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/reference"
          }
        }
      }
    }
  }
}
